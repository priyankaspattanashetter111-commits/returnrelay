# Optional. Copy to .env; never commit .env.
# Paths default to data/demo.db and data/uploads under this project.
# RR_DB=C:/path/to/returnrelay/data/demo.db
# RR_UPLOAD_ROOT=C:/path/to/returnrelay/data/uploads

# Leave unset to create a random signing key each startup.
# To preserve approvals across restarts, generate a private key of at least 32 characters locally.
# RR_APPROVAL_KEY=

# deterministic (default) or ollama (optional, local, no paid API key)
RR_LLM_PROVIDER=deterministic
RR_LLM_MODEL=llama3.2

# Use 1 only behind HTTPS; localhost HTTP development requires 0.
RR_SECURE_COOKIE=0
